{
  "manifest_version": 3,
  "name": "Holy · Progreso entre equipos",
  "version": "0.9.13",
  "description": "Guarda el minuto de los vídeos que abres desde Holy y permite continuar en otro equipo.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://192.168.1.65/*",
    "http://192.168.1.102/*",
    "http://holy-mac.local/*",
    "http://djoker/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://192.168.1.65/*",
        "http://192.168.1.102/*",
        "http://holy-mac.local/*",
        "http://djoker/*"
      ],
      "js": [
        "holy.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.streamtape.com/*",
        "https://*.flaswish.com/*",
        "https://*.filemoon.sx/*",
        "https://*.filemoon.to/*",
        "https://*.mixdrop.co/*",
        "https://*.mixdrop.ag/*",
        "https://*.vidhide.com/*",
        "https://*.streamwish.to/*",
        "https://*.voe.sx/*",
        "https://*.morencius.com/*"
      ],
      "js": [
        "player.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
