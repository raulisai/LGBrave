{
  "name": "lg-tv-lab",
  "version": "0.9.10",
  "private": true,
  "type": "module",
  "scripts": {
    "inventory": "node scripts/inventory.mjs",
    "verify:tv": "node scripts/verify-browser-ui.mjs",
    "lab:server": "node scripts/fixture-server.mjs",
    "lab:bridge": "node scripts/browser-bridge.mjs",
    "lab": "node scripts/lab-supervisor.mjs",
    "test": "node scripts/test-local.mjs",
    "lists:update": "node scripts/update-lists.mjs",
    "lists:rollback": "node scripts/update-lists.mjs --rollback",
    "validate:engine": "node scripts/validate-engine.mjs",
    "validate:native": "node scripts/validate-native.mjs",
    "validate:browser": "node scripts/validate-browser.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:native": "node scripts/build-native.mjs",
    "package": "npm run build && ares-package dist -o artifacts",
    "tv:info": "ares-device --system-info --device lg-lab",
    "tv:launch": "ares-launch --device lg-lab com.lgapp.lab",
    "desktop": "node scripts/desktop-supervisor.mjs",
    "holy": "node scripts/desktop-supervisor.mjs",
    "desktop:status": "node scripts/desktop-control.mjs status",
    "desktop:start": "node scripts/desktop-control.mjs start",
    "desktop:stop": "node scripts/desktop-control.mjs stop",
    "desktop:restart": "node scripts/desktop-control.mjs restart",
    "desktop:doctor": "node scripts/desktop-control.mjs doctor",
    "desktop:repair": "node scripts/desktop-control.mjs repair",
    "desktop:handoff": "node scripts/desktop-control.mjs handoff",
    "build:holy": "vite build --mode holy",
    "build:holy-web": "vite build --mode holy-web",
    "build:all": "npm run build && npm run build:holy && npm run build:holy-web",
    "package:holy": "npm run build:holy && ares-package dist-holy -o artifacts",
    "windows:tray": "node scripts/windows-tray.mjs",
    "holy:errors": "node scripts/holy/playback-report.mjs",
    "anime:classics:update": "node scripts/update-anime-classics.mjs",
    "holy:autostart": "node scripts/holy/autostart.mjs",
    "windows:install": "node scripts/install-windows-app.mjs",
    "holy:tastes": "node scripts/holy/taste-transfer.mjs",
    "holy:lists:update": "node scripts/update-known-lists.mjs",
    "debug:export": "node scripts/debug-export.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@webos-tools/cli": "3.2.6",
    "adblock-rs": "0.13.3",
    "vite": "8.3.5",
    "ws": "8.22.0"
  },
  "dependencies": {
    "svelte": "5.57.2"
  }
}
